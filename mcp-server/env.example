# URL base de la API de LogiTrack IQ (Spring Boot)
API_BASE_URL=http://localhost:8080

# Credenciales del usuario tecnico AGENTE (creado via POST /auth/register
# por un ADMIN, con rol AGENTE)
AGENTE_MCP_USERNAME=agente_mcp
AGENTE_MCP_PASSWORD=Agente123!

# Puerto donde el servidor MCP expondra el endpoint SSE para que n8n
# se conecte como cliente
MCP_PORT=3001
